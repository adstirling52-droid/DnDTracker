@using Microsoft.Extensions.Options
@rendermode InteractiveServer
@inject SiteHostService SiteHost
@inject IOptions<SiteSettings> SiteSettings

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="@(SiteHost.IsTrackerHost ? "/" : "dnd")">DnDTracker</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @if (SiteHost.IsTrackerHost)
        {
            <div class="nav-item px-3">
                <a class="nav-link" href="@SiteSettings.Value.PublicSiteUrl">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </a>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> D&amp;D Tracker
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="dnd" Match="NavLinkMatch.Prefix">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> D&amp;D Tracker
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="user-guide">
                <span class="bi bi-book" aria-hidden="true"></span> User Guide
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="campaigns">
                        <span class="bi bi-journal-text" aria-hidden="true"></span> Campaigns
                    </NavLink>
                </div>
                <CampaignModuleNav />
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post" class="d-inline">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-link btn btn-link border-0 p-0 text-start w-100">
                            <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Log out
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-fill" aria-hidden="true"></span> Log in
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-plus-fill" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
