@page "/Account/ResetPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using DnDTracker.Web.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities

@attribute [AllowAnonymous]

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject ILogger<ResetPassword> Logger

<PageTitle>Reset password</PageTitle>

<h1>Reset password</h1>

<div class="row">
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="text-danger" role="alert">@errorMessage</div>
        }

        @if (linkIsValid)
        {
            <EditForm Model="Input" FormName="reset-password" OnValidSubmit="ResetUserPasswordAsync" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />

                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input!.Password" id="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label for="Input.Password">New password</label>
                    <ValidationMessage For="() => Input.Password" class="text-danger" />
                </div>

                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label for="Input.ConfirmPassword">Confirm new password</label>
                    <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
                </div>

                <button type="submit" class="w-100 btn btn-lg btn-primary">Reset password</button>
            </EditForm>
        }
        else if (string.IsNullOrEmpty(errorMessage))
        {
            <p class="text-danger">This password reset link is invalid.</p>
        }
    </div>
</div>

<p>
    <a href="Account/Login">Back to log in</a>
    @if (!linkIsValid)
    {
        <span> or <a href="Account/ForgotPassword">request a new reset link</a>.</span>
    }
</p>

@code {
    private string? errorMessage;
    private bool linkIsValid;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();

        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Code))
        {
            errorMessage = "The password reset link is invalid or has expired.";
            return;
        }

        linkIsValid = true;
    }

    private async Task ResetUserPasswordAsync()
    {
        if (Input is null || string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Code))
        {
            errorMessage = "The password reset link is invalid or has expired.";
            linkIsValid = false;
            return;
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            errorMessage = "The password reset link is invalid or has expired.";
            linkIsValid = false;
            return;
        }

        var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        var result = await UserManager.ResetPasswordAsync(user, code, Input.Password);

        if (result.Succeeded)
        {
            Logger.LogInformation("User reset their password.");
            NavigationManager.NavigateTo("Account/Login?reset=1", forceLoad: true);
            return;
        }

        errorMessage = string.Join(" ", result.Errors.Select(error => error.Description));
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(100, MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        [Compare(nameof(Password))]
        public string ConfirmPassword { get; set; } = "";
    }
}
