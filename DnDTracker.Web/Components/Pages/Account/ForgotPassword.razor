@page "/Account/ForgotPassword"

@using DnDTracker.Web.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options

@attribute [AllowAnonymous]

@inject IOptions<SiteSettings> SiteSettings

<PageTitle>Forgot your password</PageTitle>

<h1>Forgot your password</h1>

<div class="row">
    <div class="col-md-6">
        <p>To reset your password, email us from the address registered on your account:</p>

        <p class="fs-5">
            <a href="mailto:@SiteSettings.Value.PasswordResetEmail?subject=DnD%20Tracker%20password%20reset">@SiteSettings.Value.PasswordResetEmail</a>
        </p>

        <p>Include your <strong>username</strong> in the message. We will reply with instructions to set a new password.</p>
    </div>
</div>

<p>
    <a href="Account/Login">Back to log in</a>
</p>

