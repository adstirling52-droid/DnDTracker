@page "/Admin/PasswordReset"

@using System.ComponentModel.DataAnnotations
@using DnDTracker.Web.Models
@using DnDTracker.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options

@attribute [Authorize(Roles = IdentityRoleNames.Admin)]

@inject PasswordResetLinkService PasswordResetLinkService
@inject IOptions<SiteSettings> SiteSettings

<PageTitle>Admin — password reset</PageTitle>

<h1>Password reset (admin)</h1>

<div class="row">
    <div class="col-lg-8">
        <p>
            After a user emails
            <a href="mailto:@SiteSettings.Value.PasswordResetEmail">@SiteSettings.Value.PasswordResetEmail</a>,
            verify their request, then generate a reset link below and paste it into your reply.
        </p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <EditForm Model="Input" FormName="admin-password-reset" OnValidSubmit="GenerateLinkAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="form-floating mb-3">
                <InputText @bind-Value="Input!.UsernameOrEmail" id="Input.UsernameOrEmail" class="form-control" autocomplete="off" aria-required="true" placeholder="username or email" />
                <label for="Input.UsernameOrEmail">Username or email</label>
                <ValidationMessage For="() => Input.UsernameOrEmail" class="text-danger" />
            </div>

            <button type="submit" class="btn btn-primary">Generate reset link</button>
        </EditForm>

        @if (result is not null)
        {
            <div class="card mt-4">
                <div class="card-header">Reset link for @result.Username</div>
                <div class="card-body">
                    <p class="mb-2"><strong>Account email:</strong> @result.Email</p>

                    <label class="form-label" for="reset-link">Reset link</label>
                    <textarea id="reset-link" class="form-control font-monospace mb-3" rows="3" readonly>@result.ResetLink</textarea>

                    <p class="mb-2"><strong>Suggested reply text</strong></p>
                    <textarea class="form-control" rows="6" readonly>@SuggestedReply</textarea>

                    <p class="mt-3 mb-0">
                        <a href="@MailtoReply">Open draft in your email client</a>
                    </p>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string? errorMessage;
    private PasswordResetLinkResult? result;

    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    private string SuggestedReply =>
        result is null
            ? ""
            : $"""
               Hi,

               Use this link to set a new password for your DnD Tracker account ({result.Username}):

               {result.ResetLink}

               The link expires after about 24 hours. If you did not request this, you can ignore this email.
               """;

    private string MailtoReply =>
        result is null
            ? ""
            : $"mailto:{Uri.EscapeDataString(result.Email!)}?subject={Uri.EscapeDataString("DnD Tracker password reset")}&body={Uri.EscapeDataString(SuggestedReply)}";

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task GenerateLinkAsync()
    {
        errorMessage = null;
        result = null;

        if (Input is null)
        {
            return;
        }

        var linkResult = await PasswordResetLinkService.GenerateAsync(Input.UsernameOrEmail);
        if (linkResult.Succeeded)
        {
            result = linkResult;
            return;
        }

        errorMessage = linkResult.ErrorMessage;
    }

    private sealed class InputModel
    {
        [Required]
        [Display(Name = "Username or email")]
        public string UsernameOrEmail { get; set; } = "";
    }
}
