@page "/campaigns/{CampaignId:guid}/npcs"
@rendermode InteractiveServer

@using System.Security.Claims
@using DnDTracker.Web.Models
@using DnDTracker.Web.Services
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject CampaignService CampaignService
@inject CampaignNpcService CampaignNpcService
@inject CampaignNpcImageService CampaignNpcImageService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>Saved NPCs</PageTitle>

@if (campaign is null)
{
    <h1>Campaign not found</h1>
    <p>The campaign may have been removed or you do not have access to it.</p>
    <a class="btn btn-secondary" href="campaigns">Back to campaigns</a>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-0">Saved NPCs</h1>
            <p class="text-muted mb-0">Campaign: @campaign.Name</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary" href="campaigns/@CampaignId/npc-generator">NPC Generator</a>
            <a class="btn btn-secondary" href="campaigns/@CampaignId">Back to campaign</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info" role="status">@statusMessage</div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="row g-3">
        <div class="col-lg-4">
            <h2 class="h5">NPCs</h2>
            @if (savedNpcs.Count == 0)
            {
                <p class="text-muted small mb-2">No NPCs saved to this campaign yet.</p>
            }
            else
            {
                <div class="list-group mb-2">
                    @foreach (var npc in savedNpcs)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action @(selectedNpcId == npc.Id ? "active" : "")"
                                @onclick="() => SelectNpc(npc.Id)">
                            <div class="fw-semibold">@npc.Name</div>
                            <div class="small @(selectedNpcId == npc.Id ? "" : "text-muted")">@npc.Occupation</div>
                        </button>
                    }
                </div>
            }
        </div>

        <div class="col-lg-8">
            <h2 class="h5">Details</h2>
            @if (!HasNpcSelection || selectedNpc is null)
            {
                <p class="text-muted mb-0">Select a saved NPC to view details or copy text for play.</p>
            }
            else
            {
                @if (HasNpcImage(selectedNpc))
                {
                    <div class="border rounded p-3 mb-3">
                        <h3 class="h6">Portrait</h3>
                        <img src="@GetNpcImageUrl(selectedNpc.Id)"
                             alt="Portrait of @selectedNpc.Name"
                             class="rounded border"
                             style="max-width: 220px; max-height: 220px; object-fit: cover;" />
                    </div>
                }

                <div class="border rounded p-3 mb-3">
                    <h3 class="h6">Identity</h3>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@selectedNpc.Name</dd>
                        <dt class="col-sm-4">Ancestry</dt>
                        <dd class="col-sm-8">@selectedNpc.Ancestry</dd>
                        <dt class="col-sm-4">Gender or presentation</dt>
                        <dd class="col-sm-8">@selectedNpc.GenderPresentation</dd>
                        <dt class="col-sm-4">Age category</dt>
                        <dd class="col-sm-8">@selectedNpc.AgeCategory</dd>
                        <dt class="col-sm-4">Occupation</dt>
                        <dd class="col-sm-8">@selectedNpc.Occupation</dd>
                    </dl>
                </div>

                <div class="border rounded p-3 mb-3">
                    <h3 class="h6">Appearance</h3>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Appearance</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.Appearance</dd>
                        <dt class="col-sm-4">Distinctive feature</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.DistinctiveFeature</dd>
                    </dl>
                </div>

                <div class="border rounded p-3 mb-3">
                    <h3 class="h6">Behaviour</h3>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Personality</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.Personality</dd>
                        <dt class="col-sm-4">Mannerism</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.Mannerism</dd>
                        <dt class="col-sm-4">Voice</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.Voice</dd>
                    </dl>
                </div>

                <div class="border rounded p-3 mb-3">
                    <h3 class="h6">Story</h3>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Background</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.Background</dd>
                        <dt class="col-sm-4">Motivation</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.Motivation</dd>
                        <dt class="col-sm-4">Secret</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.Secret</dd>
                        <dt class="col-sm-4">Current problem</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.CurrentProblem</dd>
                    </dl>
                </div>

                <div class="border rounded p-3 mb-3">
                    <h3 class="h6">Game use</h3>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Quest hook</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.QuestHook</dd>
                        <dt class="col-sm-4">Danger or complication</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.DangerOrComplication</dd>
                    </dl>
                </div>

                <div class="border rounded p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h3 class="h6 mb-0">DM summary</h3>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="CopyDmSummaryAsync">
                            Copy summary
                        </button>
                    </div>
                    <p class="preserve-line-breaks mb-0">@selectedNpc.DmSummary</p>
                </div>

                <div class="border rounded p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h3 class="h6 mb-0">Image prompt</h3>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="CopyImagePromptAsync">
                            Copy image prompt
                        </button>
                    </div>
                    <p class="preserve-line-breaks mb-0">@selectedNpc.ImagePrompt</p>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid CampaignId { get; set; }

    [SupplyParameterFromQuery]
    public Guid? Selected { get; set; }

    private Campaign? campaign;
    private string? userId;
    private List<CampaignNpc> savedNpcs = [];
    private Guid? selectedNpcId;
    private CampaignNpc? selectedNpc;
    private string? statusMessage;
    private string? errorMessage;

    private bool HasNpcSelection => selectedNpcId.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        userId = await GetUserIdAsync();
        if (userId is null)
        {
            campaign = null;
            savedNpcs = [];
            return;
        }

        campaign = await CampaignService.GetCampaignAsync(userId, CampaignId);
        await LoadSavedNpcsAsync();

        if (Selected.HasValue && savedNpcs.Any(npc => npc.Id == Selected.Value))
        {
            SelectNpc(Selected.Value);
        }
        else if (savedNpcs.Count > 0 && !selectedNpcId.HasValue)
        {
            SelectNpc(savedNpcs[0].Id);
        }
    }

    private async Task LoadSavedNpcsAsync()
    {
        if (userId is null)
        {
            savedNpcs = [];
            selectedNpcId = null;
            selectedNpc = null;
            return;
        }

        savedNpcs = await CampaignNpcService.GetAllAsync(userId, CampaignId);
        if (selectedNpcId.HasValue && savedNpcs.All(npc => npc.Id != selectedNpcId.Value))
        {
            selectedNpcId = null;
            selectedNpc = null;
        }

        if (selectedNpcId.HasValue)
        {
            selectedNpc = savedNpcs.FirstOrDefault(npc => npc.Id == selectedNpcId.Value);
        }
    }

    private void SelectNpc(Guid npcId)
    {
        selectedNpcId = npcId;
        selectedNpc = savedNpcs.FirstOrDefault(npc => npc.Id == npcId);
        ClearMessages();
    }

    private async Task CopyDmSummaryAsync()
    {
        if (selectedNpc is null)
        {
            return;
        }

        ClearMessages();
        var copied = await JS.InvokeAsync<bool>("dndCopyToClipboard", selectedNpc.DmSummary);
        statusMessage = copied ? "DM summary copied to the clipboard." : null;
        if (!copied)
        {
            errorMessage = "Copy failed. Select the summary text and copy it manually.";
        }
    }

    private async Task CopyImagePromptAsync()
    {
        if (selectedNpc is null)
        {
            return;
        }

        ClearMessages();
        var copied = await JS.InvokeAsync<bool>("dndCopyToClipboard", selectedNpc.ImagePrompt);
        statusMessage = copied ? "Image prompt copied to the clipboard." : null;
        if (!copied)
        {
            errorMessage = "Copy failed. Select the image prompt text and copy it manually.";
        }
    }

    private string GetNpcImageUrl(Guid npcId) =>
        CampaignNpcImageService.GetImageUrl(npcId);

    private static bool HasNpcImage(CampaignNpc npc) =>
        !string.IsNullOrWhiteSpace(npc.ImagePath);

    private void ClearMessages()
    {
        statusMessage = null;
        errorMessage = null;
    }

    private async Task<string?> GetUserIdAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
    }
}
