@page "/campaigns/{CampaignId:guid}/npcs"
@rendermode InteractiveServer

@using System.Security.Claims
@using DnDTracker.Web.Models
@using DnDTracker.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms

@attribute [Authorize]

@inject CampaignService CampaignService
@inject CampaignNpcService CampaignNpcService
@inject CampaignNpcImageService CampaignNpcImageService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>Saved NPCs</PageTitle>

@if (campaign is null)
{
    <h1>Campaign not found</h1>
    <p>The campaign may have been removed or you do not have access to it.</p>
    <a class="btn btn-secondary" href="campaigns">Back to campaigns</a>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-0">Saved NPCs</h1>
            <p class="text-muted mb-0">Campaign: @campaign.Name</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary" href="campaigns/@CampaignId/npc-generator">NPC Generator</a>
            <a class="btn btn-secondary" href="campaigns/@CampaignId">Back to campaign</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info" role="status">@statusMessage</div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="row g-3">
        <div class="col-lg-4">
            <h2 class="h5">NPCs</h2>
            @if (savedNpcs.Count == 0)
            {
                <p class="text-muted small mb-2">No NPCs saved yet. Generate one in the NPC Generator and save it to this campaign.</p>
            }
            else
            {
                <div class="list-group mb-2">
                    @foreach (var npc in savedNpcs)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action @(selectedNpcId == npc.Id ? "active" : "")"
                                @onclick="() => SelectNpc(npc.Id)">
                            <div class="fw-semibold">
                                @npc.Name
                                @if (npc.IsCurrent)
                                {
                                    <span class="badge @(selectedNpcId == npc.Id ? "bg-light text-dark" : "bg-primary") ms-1">Current</span>
                                }
                            </div>
                            <div class="small @(selectedNpcId == npc.Id ? "" : "text-muted")">@DisplayValue(npc.Occupation)</div>
                            @if (!string.IsNullOrWhiteSpace(npc.Location))
                            {
                                <div class="small @(selectedNpcId == npc.Id ? "" : "text-muted")">@npc.Location</div>
                            }
                        </button>
                    }
                </div>
            }

            <div class="d-flex flex-wrap gap-1">
                <button type="button"
                        class="btn btn-sm btn-secondary"
                        disabled="@(!HasNpcSelection)"
                        @onclick="ShowEditDialog">
                    Edit NPC
                </button>
                <button type="button"
                        class="btn btn-sm btn-danger"
                        disabled="@(!HasNpcSelection)"
                        @onclick="ShowDeleteDialog">
                    Remove saved NPC
                </button>
            </div>
        </div>

        <div class="col-lg-8">
            <h2 class="h5">Details</h2>
            @if (!HasNpcSelection || selectedNpc is null)
            {
                <p class="text-muted mb-0">Select a saved NPC to view details, edit fields, upload a portrait, or copy text for play.</p>
            }
            else
            {
                <div class="border rounded p-3 mb-3">
                    <h3 class="h6">Portrait</h3>
                    <div class="d-flex flex-wrap align-items-start gap-3">
                        @if (HasNpcImage(selectedNpc))
                        {
                            <img src="@GetNpcImageUrl(selectedNpc.Id)"
                                 alt="Portrait of @selectedNpc.Name"
                                 class="rounded border"
                                 style="max-width: 220px; max-height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="border rounded bg-light text-muted d-flex align-items-center justify-content-center"
                                 style="width: 220px; height: 220px;">
                                No portrait uploaded
                            </div>
                        }

                        <div>
                            <label class="btn btn-sm btn-outline-primary mb-2">
                                Upload image
                                <InputFile class="d-none"
                                           OnChange="OnPortraitSelected"
                                           accept=".png,.jpg,.jpeg,.bmp" />
                            </label>
                            @if (HasNpcImage(selectedNpc))
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary d-block"
                                        @onclick="RemovePortraitAsync">
                                    Remove image
                                </button>
                            }
                            <div class="form-text mt-2">PNG, JPG, JPEG, or BMP up to 5 MB.</div>
                        </div>
                    </div>
                </div>

                <div class="border rounded p-3 mb-3">
                    <h3 class="h6">Identity</h3>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@selectedNpc.Name</dd>
                        <dt class="col-sm-4">Ancestry</dt>
                        <dd class="col-sm-8">@selectedNpc.Ancestry</dd>
                        <dt class="col-sm-4">Gender or presentation</dt>
                        <dd class="col-sm-8">@selectedNpc.GenderPresentation</dd>
                        <dt class="col-sm-4">Age category</dt>
                        <dd class="col-sm-8">@selectedNpc.AgeCategory</dd>
                        <dt class="col-sm-4">Occupation</dt>
                        <dd class="col-sm-8">@DisplayValue(selectedNpc.Occupation)</dd>
                        <dt class="col-sm-4">Location</dt>
                        <dd class="col-sm-8">@DisplayValue(selectedNpc.Location)</dd>
                        <dt class="col-sm-4">Current NPC</dt>
                        <dd class="col-sm-8">@(selectedNpc.IsCurrent ? "Yes — shown on campaign page" : "No")</dd>
                    </dl>
                </div>

                <div class="border rounded p-3 mb-3">
                    <h3 class="h6">Appearance</h3>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Appearance</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.Appearance</dd>
                        <dt class="col-sm-4">Distinctive feature</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.DistinctiveFeature</dd>
                    </dl>
                </div>

                <div class="border rounded p-3 mb-3">
                    <h3 class="h6">Behaviour</h3>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Personality</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.Personality</dd>
                        <dt class="col-sm-4">Mannerism</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.Mannerism</dd>
                        <dt class="col-sm-4">Voice</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.Voice</dd>
                    </dl>
                </div>

                <div class="border rounded p-3 mb-3">
                    <h3 class="h6">Story</h3>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Background</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.Background</dd>
                        <dt class="col-sm-4">Motivation</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.Motivation</dd>
                        <dt class="col-sm-4">Secret</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.Secret</dd>
                        <dt class="col-sm-4">Current problem</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.CurrentProblem</dd>
                    </dl>
                </div>

                <div class="border rounded p-3 mb-3">
                    <h3 class="h6">Game use</h3>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Quest hook</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.QuestHook</dd>
                        <dt class="col-sm-4">Danger or complication</dt>
                        <dd class="col-sm-8 preserve-line-breaks">@selectedNpc.DangerOrComplication</dd>
                    </dl>
                </div>

                <div class="border rounded p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h3 class="h6 mb-0">DM summary</h3>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="CopyDmSummaryAsync">
                            Copy summary
                        </button>
                    </div>
                    <p class="preserve-line-breaks mb-0">@selectedNpc.DmSummary</p>
                </div>

                <div class="border rounded p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h3 class="h6 mb-0">Image prompt</h3>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="CopyImagePromptAsync">
                            Copy image prompt
                        </button>
                    </div>
                    <p class="preserve-line-breaks mb-0">@selectedNpc.ImagePrompt</p>
                </div>
            }
        </div>
    </div>

    @if (showEditDialog)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit NPC</h5>
                        <button type="button" class="btn-close" @onclick="CloseEditDialog" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(dialogErrorMessage))
                        {
                            <div class="alert alert-danger" role="alert">@dialogErrorMessage</div>
                        }
                        <div class="form-floating mb-3">
                            <input id="editNpcName" class="form-control" @bind="editNameInput" @bind:event="oninput" placeholder="NPC name" />
                            <label for="editNpcName">Name</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input id="editNpcOccupation" class="form-control" @bind="editOccupationInput" placeholder="Occupation" />
                            <label for="editNpcOccupation">Occupation</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input id="editNpcLocation"
                                   class="form-control"
                                   @bind="editLocationInput"
                                   maxlength="@CampaignNpcService.MaxLocationLength"
                                   placeholder="Location" />
                            <label for="editNpcLocation">Location</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="editNpcDmSummary">DM summary</label>
                            <textarea id="editNpcDmSummary"
                                      class="form-control"
                                      rows="4"
                                      maxlength="@CampaignNpcService.MaxDmSummaryLength"
                                      @bind="editDmSummaryInput"></textarea>
                        </div>
                        <div class="form-check">
                            <input id="editNpcIsCurrent"
                                   class="form-check-input"
                                   type="checkbox"
                                   @bind="editIsCurrentInput" />
                            <label class="form-check-label" for="editNpcIsCurrent">Show as current NPC</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseEditDialog">Cancel</button>
                        <button type="button" class="btn btn-primary" @onclick="SaveEditAsync">Save</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showDeleteDialog)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Remove saved NPC</h5>
                        <button type="button" class="btn-close" @onclick="CloseDeleteDialog"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">Remove <strong>@selectedNpc?.Name</strong> from this campaign? This also deletes any uploaded portrait.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseDeleteDialog">Cancel</button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync">Remove</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public Guid CampaignId { get; set; }

    [SupplyParameterFromQuery]
    public Guid? Selected { get; set; }

    private Campaign? campaign;
    private string? userId;
    private List<CampaignNpc> savedNpcs = [];
    private Guid? selectedNpcId;
    private CampaignNpc? selectedNpc;
    private long imageCacheVersion;
    private bool showEditDialog;
    private bool showDeleteDialog;
    private string? statusMessage;
    private string? errorMessage;
    private string? dialogErrorMessage;
    private string editNameInput = "";
    private string editOccupationInput = "";
    private string editLocationInput = "";
    private string editDmSummaryInput = "";
    private bool editIsCurrentInput;

    private bool HasNpcSelection => selectedNpcId.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        userId = await GetUserIdAsync();
        if (userId is null)
        {
            campaign = null;
            savedNpcs = [];
            return;
        }

        campaign = await CampaignService.GetCampaignAsync(userId, CampaignId);
        await LoadSavedNpcsAsync();

        if (Selected.HasValue && savedNpcs.Any(npc => npc.Id == Selected.Value))
        {
            SelectNpc(Selected.Value);
        }
        else if (savedNpcs.Count > 0 && !selectedNpcId.HasValue)
        {
            SelectNpc(savedNpcs[0].Id);
        }
    }

    private async Task LoadSavedNpcsAsync()
    {
        if (userId is null)
        {
            savedNpcs = [];
            selectedNpcId = null;
            selectedNpc = null;
            return;
        }

        savedNpcs = await CampaignNpcService.GetAllAsync(userId, CampaignId);
        if (selectedNpcId.HasValue && savedNpcs.All(npc => npc.Id != selectedNpcId.Value))
        {
            selectedNpcId = null;
            selectedNpc = null;
        }

        if (selectedNpcId.HasValue)
        {
            selectedNpc = savedNpcs.FirstOrDefault(npc => npc.Id == selectedNpcId.Value);
        }
    }

    private void SelectNpc(Guid npcId)
    {
        selectedNpcId = npcId;
        selectedNpc = savedNpcs.FirstOrDefault(npc => npc.Id == npcId);
        ClearMessages();
    }

    private void ShowEditDialog()
    {
        if (selectedNpc is null)
        {
            return;
        }

        editNameInput = selectedNpc.Name;
        editOccupationInput = selectedNpc.Occupation;
        editLocationInput = selectedNpc.Location;
        editDmSummaryInput = selectedNpc.DmSummary;
        editIsCurrentInput = selectedNpc.IsCurrent;
        dialogErrorMessage = null;
        showEditDialog = true;
        ClearMessages();
    }

    private void CloseEditDialog()
    {
        showEditDialog = false;
        dialogErrorMessage = null;
    }

    private async Task SaveEditAsync()
    {
        if (userId is null || !selectedNpcId.HasValue)
        {
            return;
        }

        dialogErrorMessage = null;
        var updateError = await CampaignNpcService.UpdateAsync(
            userId,
            CampaignId,
            selectedNpcId.Value,
            new CampaignNpcUpdateInput(
                editNameInput,
                editOccupationInput,
                editLocationInput,
                editDmSummaryInput,
                editIsCurrentInput));

        if (updateError is not null)
        {
            dialogErrorMessage = updateError;
            return;
        }

        showEditDialog = false;
        await LoadSavedNpcsAsync();
        statusMessage = "NPC updated.";
    }

    private async Task OnPortraitSelected(InputFileChangeEventArgs e)
    {
        if (userId is null || !selectedNpcId.HasValue)
        {
            return;
        }

        ClearMessages();

        var file = e.File;
        if (file.Size > CampaignNpcImageService.MaxFileSizeBytes)
        {
            errorMessage = "Image must be 5 MB or smaller.";
            return;
        }

        if (!CampaignNpcImageService.IsAllowedExtension(Path.GetExtension(file.Name)))
        {
            errorMessage = "Only PNG, JPG, JPEG, and BMP images are supported.";
            return;
        }

        await using var stream = file.OpenReadStream(CampaignNpcImageService.MaxFileSizeBytes);
        var (_, saveError) = await CampaignNpcImageService.SaveForNpcAsync(
            userId,
            CampaignId,
            selectedNpcId.Value,
            stream,
            file.Name);

        if (saveError is not null)
        {
            errorMessage = saveError;
            return;
        }

        imageCacheVersion++;
        await LoadSavedNpcsAsync();
        statusMessage = "Portrait uploaded.";
    }

    private async Task RemovePortraitAsync()
    {
        if (userId is null || !selectedNpcId.HasValue)
        {
            return;
        }

        ClearMessages();

        var clearError = await CampaignNpcImageService.ClearForNpcAsync(userId, CampaignId, selectedNpcId.Value);
        if (clearError is not null)
        {
            errorMessage = clearError;
            return;
        }

        imageCacheVersion++;
        await LoadSavedNpcsAsync();
        statusMessage = "Portrait removed.";
    }

    private void ShowDeleteDialog()
    {
        showDeleteDialog = true;
        ClearMessages();
    }

    private void CloseDeleteDialog() => showDeleteDialog = false;

    private async Task ConfirmDeleteAsync()
    {
        if (userId is null || !selectedNpcId.HasValue)
        {
            return;
        }

        ClearMessages();
        var deleteError = await CampaignNpcService.DeleteAsync(userId, CampaignId, selectedNpcId.Value);
        showDeleteDialog = false;

        if (deleteError is not null)
        {
            errorMessage = deleteError;
            return;
        }

        selectedNpcId = null;
        selectedNpc = null;
        await LoadSavedNpcsAsync();
        statusMessage = "Saved NPC removed.";
    }

    private async Task CopyDmSummaryAsync()
    {
        if (selectedNpc is null)
        {
            return;
        }

        ClearMessages();
        var copied = await JS.InvokeAsync<bool>("dndCopyToClipboard", selectedNpc.DmSummary);
        statusMessage = copied ? "DM summary copied to the clipboard." : null;
        if (!copied)
        {
            errorMessage = "Copy failed. Select the summary text and copy it manually.";
        }
    }

    private async Task CopyImagePromptAsync()
    {
        if (selectedNpc is null)
        {
            return;
        }

        ClearMessages();
        var copied = await JS.InvokeAsync<bool>("dndCopyToClipboard", selectedNpc.ImagePrompt);
        statusMessage = copied ? "Image prompt copied to the clipboard." : null;
        if (!copied)
        {
            errorMessage = "Copy failed. Select the image prompt text and copy it manually.";
        }
    }

    private string GetNpcImageUrl(Guid npcId) =>
        CampaignNpcImageService.GetImageUrl(npcId, imageCacheVersion);

    private static bool HasNpcImage(CampaignNpc npc) =>
        !string.IsNullOrWhiteSpace(npc.ImagePath);

    private static string DisplayValue(string value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private void ClearMessages()
    {
        statusMessage = null;
        errorMessage = null;
    }

    private async Task<string?> GetUserIdAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
    }
}
