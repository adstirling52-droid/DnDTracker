@page "/user-guide"
@layout MainLayout
@attribute [AllowAnonymous]

@inject UserGuideService UserGuideService
@inject IJSRuntime JS

<PageTitle>User Guide</PageTitle>

<h1 class="visually-hidden">User Guide</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
else if (guideHtml is null)
{
    <p class="text-muted">Loading user guide…</p>
}
else
{
    <article class="user-guide">
        @((MarkupString)guideHtml)
    </article>
}

@code {
    private string? guideHtml;
    private string? errorMessage;
    private bool anchorsInitialized;

    protected override async Task OnInitializedAsync()
    {
        (guideHtml, errorMessage) = await UserGuideService.GetHtmlAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (guideHtml is not null && !anchorsInitialized)
        {
            await JS.InvokeVoidAsync("dndInitUserGuideAnchors");
            anchorsInitialized = true;
        }
    }
}
