@using Microsoft.Extensions.Options
@inject IOptions<SiteSettings> SiteSettings

<section class="hero">
    <h1>Alan Stirling</h1>
    <p class="lead">Software developer. Personal projects and experiments.</p>
</section>

<section class="projects">
    <h2>Projects</h2>

    <article class="project-card">
        <h3><a href="@SiteSettings.Value.TrackerUrl">D&amp;D Tracker</a></h3>
        <p>
            A web app for managing tabletop RPG campaigns — track characters, items,
            roll tables, and more. Built with ASP.NET Core Blazor Server.
        </p>
        <a class="btn btn-primary" href="@SiteSettings.Value.TrackerUrl">Open D&amp;D Tracker</a>
    </article>
</section>
