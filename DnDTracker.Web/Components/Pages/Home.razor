@page "/"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject SiteHostService SiteHost

<PageTitle>@(SiteHost.IsTrackerHost ? "D&D Tracker" : "Alan Stirling")</PageTitle>

@if (SiteHost.IsTrackerHost)
{
    <LayoutView Layout="typeof(Layout.MainLayout)">
        <TrackerHomeContent />
    </LayoutView>
}
else
{
    <LayoutView Layout="typeof(Layout.LandingLayout)">
        <PersonalHomeContent />
    </LayoutView>
}
